;; kanata configuration
;;
;; Thumb keys:
;;   無変換 (Muhenkan, left)  -> tap = F13 (=英数/IME OFF), hold = RIGHT Ctrl
;;     Held, every key becomes Ctrl+key -- Ctrl+A..Z 全部、Ctrl+1..9 (タブ切替) も。
;;     Right Ctrl で発火するので、左 Ctrl ベースの defoverrides (Home/Left/...) には
;;     横取りされない。
;;     例外 1: 無変換+[/] は defoverrides で Alt+Left/Right (browser back/forward) に
;;             置換 -- Mac の Cmd+[/] に近い指の動き。
;;     例外 2: 無変換+Tab = super-alt-tab (Alt を保持したまま Tab 連打でウィンドウを
;;             サイクル、無変換を離すと確定)。Mac の Cmd+Tab と同じ操作感。詳細は @atab。
;;             このときだけ握っている右 Ctrl を unmod で一時的に外す (詳細は @atab)。
;;   変換   (Henkan,   right) -> tap = F14 (=かな/IME ON),  hold = NUMS layer
;;     (q..p = 1..0, 1..0 = F1..F10, h/j/k/l = ←↓↑→,
;;      n/m/,/. = Home/PgDn/PgUp/End)
;;
;; Why F13/F14 instead of Muhenkan/Henkan: when the Windows layout is US
;; (00000409), the Muhenkan/Henkan scancodes have no key in that layout and are
;; not translated to a VK, so the IME never sees them. F13-F24 are
;; layout-independent, so they reach the IME under any layout. Bind them in the
;; IME: F13 = "IME off / 直接入力", F14 = "ひらがな" (see keymap.txt).
;;
;; Trade-off: putting a hold action on the frequently-tapped 英数 key risks
;; "rollover misfire". 無変換 uses tap-hold-press (modifier engages on the next
;; key press) since fast Ctrl+letter rolls are the primary use; 変換 uses
;; tap-hold-release (safer for layer activation since a stray hold would replay
;; the buffered key under the wrong layer). Tune the 200ms timeouts if needed:
;;   - raise -> fewer misfires, but feels laggier
;;   - lower -> snappier, but more misfires
;; If the 英数 key ever feels unreliable, revert 無変換 to a plain `muhenkan`.
;;
;; vim 風の矢印 (h/j/k/l = ←↓↑→) は変換側 NUMS layer のみ。無変換側はモディファイア
;; 専用にしたので 無変換+h/j/k/l は Ctrl+H/J/K/L になる。
;;
;; Pairs with: Windows layout set to US (HKCU Substitutes 00000411->00000409)
;; for US symbols, and the IME keymap (keymap.txt) binding F13/F14.

(defcfg
  process-unmapped-keys yes
)

;; 無変換 hold は「右 Ctrl を押しっぱなし + MH layer」の multi。
;;   - 右 Ctrl を握るので、defsrc に列挙していないキーも含め 無変換+任意キー =
;;     Ctrl+任意キー が全部効く (無変換+c = Ctrl+C など。列挙漏れで素通しになる事故を防ぐ
;;     ため、旧来の "右 Ctrl 出しっぱなし" 方式を維持する)。Right Ctrl を使うのは左 Ctrl
;;     ベースの defoverrides (Ctrl+a -> Home 等) に横取りされないため -- 無変換+a は
;;     Select All のまま、Home にはならない。
;;   - MH layer は Tab だけ super-alt-tab (@atab) に差し替え、他は透過 (_)。Tab のときは
;;     握っている右 Ctrl を @atab 内の unmod で一時解除するので Ctrl+Alt+Tab (Windows の
;;     別モードの固定スイッチャ) にならず、純粋な Alt+Tab になる。
;;
;; 変換 hold layer (NUMS): numbers / function keys を 1 段ずらして並べる。
;;   - q..p   = 1..0           (ホームポジションの 1 段下に数字)
;;   - 1..0   = F1..F10        (元の数字段に F キー)
;;   - h/j/k/l = ←↓↑→
;;   - n/m/,/. = Home/PgDn/PgUp/End (矢印の真下に "強い版" の移動を並べる)
(defsrc
  1 2 3 4 5 6 7 8 9 0
  q w e r t y u i o p
  h j k l
  muhenkan henkan
  a b f n lctl d [ ]
  m , .
  tab
)

(deflayer base
  1 2 3 4 5 6 7 8 9 0
  q w e r t y u i o p
  h j k l
  @mh @hk
  a b f n lctl d [ ]
  m , .
  tab
)

(deflayer nums
  f1 f2 f3 f4 f5 f6 f7 f8 f9 f10
  1  2  3  4  5  6  7  8  9  0
  left down up right
  _ _
  _ _ _ home _ _ _ _
  pgdn pgup end
  _
)

;; MH layer (無変換 hold): 右 Ctrl は @mh の multi 側で握っているので、ここでは Tab
;; だけ super-alt-tab に差し替え、他は全部透過 (_) にする。位置は defsrc と 1:1 対応。
(deflayer mh
  _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _
  _ _ _ _
  _ _
  _ _ _ _ _ _ _ _
  _ _ _
  @atab
)

;; vkalt: super-alt-tab 用に「押しっぱなしにする」Alt。@atab が押し、無変換 を離した
;; とき (@mh の on-release) に離す = 選択確定。保険として ~1.5s アイドルでも離す
;; (キーアップを取りこぼして Alt が握りっぱなしになる事故の復旧)。
(defvirtualkeys
  vkalt lalt
)

(defalias
  ;; tap = layout-independent IME key (F13/F14).
  ;; 無変換: hold = 右 Ctrl (全キー Ctrl 化) + MH layer (Tab を super-alt-tab に)。
  ;;   同時に on-release で vkalt を離す (super-alt-tab の確定)。
  ;; 変換:   hold = NUMS layer (release-favored、誤発火しにくい)
  mh (tap-hold-press 200 200 f13
       (multi
         rctl
         (layer-while-held mh)
         (on-release release-vkey vkalt)))
  hk (tap-hold-release 200 200 f14 (layer-while-held nums))

  ;; super-alt-tab: Alt (vkalt) を押して保持したまま Tab を 1 回叩く。Alt は Tab を
  ;; 離しても握られたままなので、無変換 を押しっぱなしで Tab を連打すれば 3 枚以上
  ;; 先までサイクルできる。無変換 を離すと @mh の on-release で Alt が離れて確定
  ;; (Mac の Cmd+Tab と同じ)。
  ;;   - (unmod (rctl lctl) tab): このとき 無変換 で握っている右 Ctrl を一時解除して
  ;;     Tab を送る。Ctrl+Alt+Tab になるのを防ぐため。Shift は解除しないので、
  ;;     無変換+Shift+Tab は Alt+Shift+Tab = 逆順サイクルのまま。
  ;;   - macro の 5(ms) は Tab より先に Alt を確実に押させるためのディレイ。
  ;;   - on-idle 1500 は握りっぱなし事故に対する保険。Tab を叩いている間はアイドル扱いに
  ;;     ならないので途中で確定はしない (1.5s 以上手が止まると確定する。数字は好みで調整可)。
  atab (multi
         (on-idle 1500 release-vkey vkalt)
         (macro (on-press press-vkey vkalt) 5 (unmod (rctl lctl) tab)))

  ;; Win key is left as plain `lmet` (no remap) -- Start menu / Win+L / Win+D /
  ;; Win+E etc. all behave normally.
)

;; macOS-style Emacs caret motion / editing:
;;   Ctrl+a -> Home (行頭)        Ctrl+e -> End (行末)
;;   Ctrl+b -> Left (←)           Ctrl+f -> Right (→)
;;   Ctrl+p -> Up (↑)             Ctrl+n -> Down (↓)
;;   Ctrl+d -> Delete (前方削除)   Ctrl+[ -> Esc
;;   Ctrl+h -> Backspace (後方削除)
;; (Ctrl+k / Ctrl+o are NOT remapped -- they pass through native so terminals keep
;; their readline bindings: Ctrl+k = kill-to-EOL, Ctrl+o = operate-and-get-next.)
;;
;; defoverrides (not defchordsv2): an override fires whenever all its keys are
;; held, re-checked on every key event with NO timeout. So you can keep Ctrl held
;; and tap these repeatedly and every press fires. (defchordsv2's timeout is
;; measured from the first Ctrl press, so holding Ctrl makes the second tap time
;; out and the bare key leaks through -- which is why we don't use it.)
;;
;; Only the listed Ctrl combos are remapped; every other Ctrl shortcut (C-c, C-v,
;; C-x, C-z, C-s, C-Backspace, C-Left/Right, C-1..9, ...) passes through. Trade-
;; off: the native meaning of the remapped ones is lost (C-a select-all, C-f find,
;; C-b bold, C-e, C-n new, C-p print, C-d bookmark, C-[ ...). Unlike macOS (where
;; these sit on Ctrl because Cmd is the shortcut modifier), Windows has no separate
;; modifier and kanata can't tell whether a text field is focused, so this is global.
;; 無変換 hold = Right Ctrl はこの左 Ctrl ベースの defoverrides には横取りされない
;; -- 無変換+a/b/f/n/d/p/h/e/[ は Ctrl+letter のまま効く。
;;
;; lctl also covers CapsLock (mapped to Left Ctrl via the Windows Scancode Map).
;; If you also use the *right* Ctrl for these, add (rctl a) (home) ... lines too.
;;
;; rctl+[/] (= 無変換+[/]) -> Alt+Left/Right = browser back/forward (Chrome /
;; Edge / Explorer / VSCode 等 Windows のほぼ全部のアプリで効く)。Mac の Cmd+[/]
;; に近い指の動きで戻る・進むができる。代償: 無変換+[ から Esc (Ctrl+[ = ASCII 0x1B)
;; が出なくなる -- Esc は物理 Esc キーか左 Ctrl+[ (上の (lctl [) (esc) で Esc 化済み)
;; で取れる。
(defoverrides
  (lctl a) (home)
  (lctl e) (end)
  (lctl b) (left)
  (lctl f) (right)
  (lctl p) (up)
  (lctl n) (down)
  (lctl d) (del)
  (lctl [) (esc)
  (lctl h) (bspc)
  (rctl [) (lalt left)
  (rctl ]) (lalt right)
)
